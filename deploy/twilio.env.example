# Environment of the Twilio agent (deploy/compose.yaml, service "agent-twilio").
# Copy to deploy/twilio.env (git-ignored) and fill in. No secret belongs in this template.

# The account's Auth Token. Every stream's X-Twilio-Signature is checked with it, and the REST
# call control (transfer_call, send_dtmf, end_call) authenticates with it.
TWILIO_AUTH_TOKEN=
# The account SID (AC...), for call control.
BRISVOX_TWILIO_ACCOUNT_SID=
# E.164 caller id of transfers (a number of your account or a verified one).
BRISVOX_TWILIO_CALLER_ID=

# The stream URL EXACTLY as written in the TwiML <Stream url="...">: wss://, the public host
# of your TLS proxy, and the path /twilio/stream. A mismatch fails every signature check.
BRISVOX_TWILIO_PUBLIC_URL=wss://agent.example.com/twilio/stream
# REQUIRED: the server does not start the Twilio listener (the container exits with an error
# naming this variable) until this has a value or BRISVOX_TWILIO_ALLOW_STATIC_URL=1 is set.
# Per-call stream URLs (recommended, docs/providers/twilio.md): at least 32 random bytes, for
# example `openssl rand -base64 48`. Your voice webhook then answers each call with the stream URL
# plus a signed single-use segment minted from the CallSid (examples/phone-receptionist/
# twiml_server.py does this with the same variable); a captured X-Twilio-Signature cannot be
# replayed.
BRISVOX_TWILIO_STREAM_SECRET=
# Only if your TwiML cannot mint the segment (a static TwiML Bin): leave the secret above empty
# and accept the fixed URL instead (legacy: its signature is one constant that anyone who saw it
# once can replay):
# BRISVOX_TWILIO_ALLOW_STATIC_URL=1

# Provider keys named by deploy/agents/phone.toml (`api_key_env`).
ASSEMBLYAI_API_KEY=
GROQ_API_KEY=
DEEPGRAM_API_KEY=

# Bearer token that /metrics requires (the health listener is on 0.0.0.0 inside the container,
# so /metrics is off without it). Prometheus: `authorization: { credentials: <token> }`.
# BRISVOX_METRICS_TOKEN=

BRISVOX_MAX_SESSIONS=256
# BRISVOX_PROVIDER_LIMITS=assemblyai=50,openai_compatible=100,deepgram_aura=50
# RUST_LOG=info
