# Environment of the websocket agent (deploy/compose.yaml, service "agent-ws").
# Copy to deploy/ws.env (git-ignored) and fill in. No secret belongs in this template.

# Provider keys named by deploy/agents/web.toml (`api_key_env`).
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
CARTESIA_API_KEY=

# Credentials of the websocket listener (docs/SECURITY.md). Your backend signs short-lived
# single-use session tokens with this secret (at least 32 random bytes; `openssl rand -base64 48`)
# and the visitor's page sends one as `?token=`, `Authorization: Bearer` or the WebSocket
# subprotocol `brisvox-token.<token>`. Required before the port is published beyond this
# machine (then also remove BRISVOX_INSECURE_LISTENERS from deploy/compose.yaml).
# BRISVOX_SESSION_SECRET=
# While rotating the secret, the previous one still verifies:
# BRISVOX_SESSION_SECRET_PREV=
# Bearer token that /metrics requires (the health listener is on 0.0.0.0 inside the container,
# so /metrics is off without it). Prometheus: `authorization: { credentials: <token> }`.
# BRISVOX_METRICS_TOKEN=

# Calls this container serves at once (docs/OPERATIONS.md). More are refused with HTTP 503.
BRISVOX_MAX_SESSIONS=256

# Concurrent calls allowed per provider, so a provider rate limit is not hit by accident
# (names are the agent file's `provider` values). Unset: no limit.
# BRISVOX_PROVIDER_LIMITS=deepgram=50,openai=100,cartesia=50

# Log filter and format (the image defaults to JSON lines).
# RUST_LOG=info
