{
  "name": "@brisvox/agent",
  "version": "0.1.2",
  "description": "TypeScript SDK for the brisvox agent protocol: the application logic of a real-time voice call (tools, events, commands) in async TypeScript.",
  "keywords": [
    "voice",
    "voice-agent",
    "realtime",
    "llm",
    "telephony"
  ],
  "homepage": "https://bilal07karadeniz.github.io/brisvox/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bilal07karadeniz/brisvox.git",
    "directory": "sdk/typescript"
  },
  "bugs": {
    "url": "https://github.com/bilal07karadeniz/brisvox/issues"
  },
  "author": "brisvox contributors",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node scripts/run-tests.mjs"
  },
  "dependencies": {
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/ws": "8.18.2",
    "typescript": "7.0.2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
