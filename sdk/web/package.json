{
  "name": "@brisvox/web",
  "version": "0.1.2",
  "description": "Browser client for Brisvox voice calls: WebRTC with an automatic WebSocket fallback, microphone capture, playback and barge-in, in one dependency-free ES module.",
  "keywords": [
    "voice",
    "webrtc",
    "websocket",
    "microphone",
    "browser"
  ],
  "homepage": "https://bilal07karadeniz.github.io/brisvox/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bilal07karadeniz/brisvox.git",
    "directory": "sdk/web"
  },
  "bugs": {
    "url": "https://github.com/bilal07karadeniz/brisvox/issues"
  },
  "author": "brisvox contributors",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "main": "./brisvox-call.js",
  "module": "./brisvox-call.js",
  "types": "./brisvox-call.d.ts",
  "exports": {
    ".": {
      "types": "./brisvox-call.d.ts",
      "default": "./brisvox-call.js"
    },
    "./brisvox-call.js": {
      "types": "./brisvox-call.d.ts",
      "default": "./brisvox-call.js"
    }
  },
  "files": [
    "brisvox-call.js",
    "brisvox-call.d.ts",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.4"
  },
  "scripts": {
    "test": "node scripts/run-tests.mjs"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
