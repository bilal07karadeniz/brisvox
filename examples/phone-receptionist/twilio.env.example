# Environment of the phone receptionist (README.md). Copy to twilio.env (git-ignored: the name
# ends in .env), fill in, and load it before starting the server. No secret belongs in this file.

# --- brisvox-server ------------------------------------------------------------------------
BRISVOX_AGENT_FILE=examples/phone-receptionist/agent.toml
BRISVOX_TWILIO_ADDR=127.0.0.1:8082
# The stream URL EXACTLY as written in the TwiML <Stream url="...">: wss://, the PUBLIC host,
# the path /twilio/stream. Every stream's X-Twilio-Signature is checked against it.
BRISVOX_TWILIO_PUBLIC_URL=wss://REPLACE-ME.ngrok-free.app/twilio/stream
# At least 32 random bytes (for example `openssl rand -base64 48`). The server then accepts a
# stream only on a signed, single-use per-call URL, and twiml_server.py (below, same variable)
# mints it from each call's CallSid. The server does not start without this or
# BRISVOX_TWILIO_ALLOW_STATIC_URL=1.
BRISVOX_TWILIO_STREAM_SECRET=
# Legacy, only for a TwiML Bin with the fixed URL (leave BRISVOX_TWILIO_STREAM_SECRET unset
# and uncomment): the fixed URL's X-Twilio-Signature is one constant that anyone who saw it once
# can replay.
# BRISVOX_TWILIO_ALLOW_STATIC_URL=1
# Auth Token and account SID of your Twilio account (call control authenticates with them).
TWILIO_AUTH_TOKEN=
BRISVOX_TWILIO_ACCOUNT_SID=
BRISVOX_CALL_CONTROL=twilio
# E.164 caller id of transfers (a number of your account or a verified one). Needed for warm
# transfers; set it anyway.
BRISVOX_TWILIO_CALLER_ID=

# Provider keys named by agent.toml (`api_key_env`).
ASSEMBLYAI_API_KEY=
GROQ_API_KEY=
DEEPGRAM_API_KEY=

BRISVOX_MAX_SESSIONS=16
# RUST_LOG=info

# --- twiml_server.py (the voice webhook) -----------------------------------------------------
# It reads BRISVOX_TWILIO_STREAM_SECRET (above) and TWILIO_AUTH_TOKEN from the same file.
# Same value as BRISVOX_TWILIO_PUBLIC_URL (the webhook appends the per-call segment to it).
BRISVOX_STREAM_URL=wss://REPLACE-ME.ngrok-free.app/twilio/stream
# The URL Twilio calls for a call, exactly as configured on the number (used to verify
# X-Twilio-Signature; with TWILIO_AUTH_TOKEN set an unsigned request is refused).
TWIML_PUBLIC_URL=https://REPLACE-ME.ngrok-free.app/voice

# --- place_call.py (outbound reminders, reminder.toml) -----------------------------------------
# REMINDER_FROM is a number of your account; the callee is the argument of the script.
REMINDER_FROM=
