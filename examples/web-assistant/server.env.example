# Environment of the web assistant's server (README.md). Copy to server.env (git-ignored: the
# name ends in .env), fill in, and load it before starting brisvox-server. No secret belongs here.

BRISVOX_AGENT_FILE=examples/web-assistant/agent.toml

# The WebRTC signaling listener (WHIP-style HTTP POST; needs a server built with the `webrtc`
# feature). Loopback: only this machine can start calls. The media UDP socket defaults to the
# same IP and port number.
BRISVOX_WEBRTC_ADDR=127.0.0.1:8088
# Media (UDP) must be on a non-loopback address even on one machine: browsers do not send ICE to
# 127.0.0.1. Put this machine's LAN address here (ipconfig / ip addr), e.g. 192.168.1.10.
BRISVOX_WEBRTC_UDP_ADDR=192.168.1.10:8088
BRISVOX_WEBRTC_CANDIDATE_IP=192.168.1.10

# The origin of the page (python3 -m http.server 8000 in examples/web-assistant/web), so the
# browser may call the signaling endpoint from there.
BRISVOX_WEBRTC_CORS_ORIGIN=http://localhost:8000

# Optional static bearer token for development: the page has a field for it. Shared and never
# expiring: fine on loopback or a LAN, not for the public. The server refuses to listen on a
# non-loopback address with neither this nor a session secret (docs/SECURITY.md).
BRISVOX_WEBRTC_TOKEN=

# For a real site: your backend signs a short-lived, single-use session token per visitor with this
# secret (at least 32 random bytes: `openssl rand -base64 48`) and gives it to the page, which sends
# it as its Bearer token. Commented out here so this template stays valid as it is. While rotating
# the secret, the old one goes in BRISVOX_SESSION_SECRET_PREV.
# BRISVOX_SESSION_SECRET=
# BRISVOX_SESSION_SECRET_PREV=

# Behind an HTTPS reverse proxy: the proxies whose X-Forwarded-For is believed (so the per-address
# limits count visitors, not the proxy). Limits per client address: calls at once, offers a minute.
# BRISVOX_TRUSTED_PROXIES=10.0.0.0/8
# BRISVOX_WEBRTC_MAX_CALLS_PER_IP=8
# BRISVOX_WEBRTC_OFFERS_PER_MINUTE=5

# For a server other than this machine, bind the public interface and say which address browsers
# should send media to (the host's public IP, with the UDP port forwarded). Put an HTTPS reverse
# proxy in front of the TCP signaling port (browsers need HTTPS for the microphone, and a
# man-in-the-middle of plain-HTTP signaling can swap the DTLS fingerprint and hear the call).
# BRISVOX_WEBRTC_ADDR=0.0.0.0:8088
# BRISVOX_WEBRTC_UDP_ADDR=0.0.0.0:8088
# BRISVOX_WEBRTC_CANDIDATE_IP=203.0.113.10

# Clients behind a network that blocks UDP (docs/DEPLOY.md, "WebRTC: making the server reachable"):
# a passive TCP candidate next to the UDP one, and/or browser TURN credentials. Optional.
# BRISVOX_WEBRTC_TCP_ADDR=0.0.0.0:8088
# BRISVOX_TURN_PROVIDER=coturn
# BRISVOX_TURN_URLS=turns:turn.example.com:443?transport=tcp
# BRISVOX_TURN_SECRET=

# Provider keys named by agent.toml (`api_key_env`).
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
CARTESIA_API_KEY=

BRISVOX_MAX_SESSIONS=16
# RUST_LOG=info
